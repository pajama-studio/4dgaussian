  "milestones": [
    {
      "title": {
        "en": "Clear",
        "zh": "清屏"
      },
      "expected": {
        "en": "A black canvas with a rising presented-frame count; zero draws.",
        "zh": "黑色画布，显示帧数增长，绘制数为零。"
      },
      "post": "01-start-with-a-pixel",
      "source": "src/workshop_surface.rs"
    },
    {
      "title": {
        "en": "Triangle",
        "zh": "三角形"
      },
      "expected": {
        "en": "Three colored corners. The rasterizer interpolates RGB between them.",
        "zh": "三个角颜色不同，光栅器在它们之间插值 RGB。"
      },
      "post": "03-your-first-triangle",
      "source": "src/workshop.wgsl"
    },
    {
      "title": {
        "en": "Solid quad",
        "zh": "实心矩形"
      },
      "expected": {
        "en": "Two triangles form an opaque orange quad. Color comes from a Rust storage record.",
        "zh": "两个三角形拼成不透明橙色 quad，颜色来自 Rust storage 记录。"
      },
      "post": "04-numbers-into-gpu-memory",
      "source": "src/workshop.rs"
    },
    {
      "title": {
        "en": "One Gaussian",
        "zh": "一个 Gaussian"
      },
      "expected": {
        "en": "The same quad has a soft footprint because each fragment evaluates exp(−r²/2).",
        "zh": "同一个 quad 变成柔软的光斑，因为每个片元计算 exp(−r²/2)。"
      },
      "post": "05-soft-splats-and-alpha",
      "source": "src/workshop.wgsl"
    },
    {
      "title": {
        "en": "Alpha and ordering",
        "zh": "透明度与排序"
      },
      "expected": {
        "en": "Far blue then near red. Reverse draw order to see that alpha composition is not commutative.",
        "zh": "先远蓝、后近红；反转绘制顺序，观察 alpha 合成不满足交换律。"
      },
      "post": "05-soft-splats-and-alpha",
      "source": "src/workshop.wgsl"
    },
    {
      "title": {
        "en": "3D camera",
        "zh": "三维相机"
      },
      "expected": {
        "en": "Orbit the anisotropic Gaussians. Projected covariance changes their screen-space ellipses.",
        "zh": "绕转各向异性 Gaussian，投影协方差改变屏幕椭圆。"
      },
      "post": "06-camera-and-ellipses",
      "source": "src/workshop.wgsl"
    },
    {
      "title": {
        "en": "Time and motion",
        "zh": "时间与运动"
      },
      "expected": {
        "en": "Scrub time, pause, then orbit. Motion and temporal opacity are evaluated before projection and sorting.",
        "zh": "拖动时间、暂停，再绕转。运动和时间透明度在投影排序前求值。"
      },
      "post": "08-make-time-explicit",
      "source": "src/workshop.rs"
    },
    {
      "title": {
        "en": "Real STG-Lite model",
        "zh": "真实 STG-Lite 模型"
      },
      "expected": {
        "en": "Load the pretrained research fixture, then scrub time and orbit through the shared StgPass.",
        "zh": "加载预训练研究数据，通过共享 StgPass 拖动时间并绕转。"
      },
      "post": "07-load-a-real-model",
      "source": "src/stg_pass.rs"
    }
  ],
