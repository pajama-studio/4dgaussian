{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pajama-gaussian-lab",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "routes": [{ "pattern": "gaussian.pajama.studio", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}

